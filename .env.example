# Application
APP_NAME=LoanCollectionPlatform
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Database (local development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=loan_collection

# Redis (local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible storage) - optional for local dev
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_change_me
MINIO_BUCKET=loan-collection

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Engine
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8001
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
WHISPER_MODEL=large-v3

# Telephony (Mock)
TELEPHONY_HOST=localhost
TELEPHONY_PORT=8002

# Exotel (for production)
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SID=your-exotel-sid
EXOTEL_SUBDOMAIN=your-subdomain

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
