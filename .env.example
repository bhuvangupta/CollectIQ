# Application
APP_NAME=LoanCollectionPlatform
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# Database (local development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=loan_collection

# Redis (local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible storage) - optional for local dev
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_change_me
MINIO_BUCKET=loan-collection

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Engine
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8001

# LLM Provider (ollama, groq, or sarvam)
LLM_PROVIDER=ollama

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Groq Configuration (used when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=qwen-qwq-32b

# Sarvam AI Configuration (used when LLM_PROVIDER=sarvam or STT_PROVIDER=sarvam)
# Get your API key from https://dashboard.sarvam.ai
# Sarvam offers ₹1000 free credits for new users
# Best for Indian languages (11 languages including Hindi, Tamil, Telugu, etc.)
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_LLM_MODEL=sarvam-m
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=Anushka

# Speech-to-Text Provider (whisper, groq, or sarvam)
STT_PROVIDER=whisper

# Text-to-Speech Provider (edge or sarvam)
# edge: Microsoft Edge TTS (free, good quality, supports Hindi)
# sarvam: Sarvam AI TTS (better Indian voices, requires API key)
TTS_PROVIDER=edge

# Whisper Configuration (used when STT_PROVIDER=whisper)
WHISPER_MODEL=large-v3

# Groq STT Configuration (used when STT_PROVIDER=groq)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Telephony Service
TELEPHONY_HOST=localhost
TELEPHONY_PORT=8002

# Telephony Provider (mock or exotel)
# mock: For development/testing without real phone calls
# exotel: For production phone calls via Exotel API
TELEPHONY_PROVIDER=mock

# Exotel Configuration (used when TELEPHONY_PROVIDER=exotel or campaign telephony_provider=exotel)
# Get credentials from https://exotel.com/dashboard
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SID=your-exotel-sid
EXOTEL_SUBDOMAIN=api
EXOTEL_CALLER_ID=+91XXXXXXXXXX
EXOTEL_WEBHOOK_URL=https://your-domain.com/webhooks/exotel

# Voice AI Provider (bolna, elevenlabs, exotel)
# bolna: Bolna AI for conversational AI calls
# elevenlabs: ElevenLabs for AI voice agents
# exotel: Direct Exotel calls (basic IVR, no AI)
VOICE_AI_PROVIDER=bolna

# Bolna AI Configuration (used when VOICE_AI_PROVIDER=bolna)
# Get your API key from https://app.bolna.ai
BOLNA_API_KEY=your-bolna-api-key
BOLNA_AGENT_ID=your-bolna-agent-id
VOICE_AI_WEBHOOK_URL=https://your-domain.com/api/v1/voice/webhook

# ElevenLabs Configuration (used when VOICE_AI_PROVIDER=elevenlabs)
# Get your API key from https://elevenlabs.io/app/settings/api-keys
# Requires Twilio phone number connected in ElevenLabs dashboard
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_PHONE_NUMBER_ID=your-elevenlabs-phone-number-id

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
